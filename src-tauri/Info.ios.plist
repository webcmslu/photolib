<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the iOS app's Info.plist by Tauri. -->
<plist version="1.0">
<dict>
	<!-- The Phototek server is on the NAS, at home: plain HTTP on the local
	     network, or through a VPN such as Tailscale (100.x addresses, which
	     iOS doesn't count as local). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Phototek connects to the Phototek server on your NAS to show your photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Phototek backs up your photos and videos to the Phototek server on your NAS, and can then remove them from this phone to free up space.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
